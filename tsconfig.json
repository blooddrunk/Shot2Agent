{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "erasableSyntaxOnly": true, "noEmit": true, "allowImportingTsExtensions": true,
    "skipLibCheck": true, "types": ["node"]
  },
  "include": ["packages/*/src/**/*.ts", "services/*/src/**/*.ts", "apps/*/src/**/*.ts"]
}
