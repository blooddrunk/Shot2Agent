{
  "name": "shot2agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Screenshot-driven asynchronous agent tasks",
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "test": "node --experimental-strip-types --test packages/contracts/test/*.test.mjs packages/core/test/*.test.mjs packages/local/test/*.test.mjs packages/desktop/test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "check": "npm run lint && npm run typecheck && npm run desktop:typecheck && npm test && npm run build && npm run desktop:ui && npm run smoke",
    "local": "node --experimental-strip-types apps/cli/src/local.ts",
    "remote": "node --experimental-strip-types apps/cli/src/remote.ts",
    "relay": "node --experimental-strip-types services/relay/src/main.ts",
    "mvp": "node --experimental-strip-types apps/cli/src/mvp.ts",
    "smoke": "node scripts/smoke.mjs",
    "desktop:ui": "vite build --config apps/desktop/vite.config.mjs",
    "desktop:typecheck": "vue-tsc -p apps/desktop/tsconfig.json --noEmit",
    "desktop:build": "npm run build && npm run desktop:ui && cd apps/desktop && tauri build --no-bundle",
    "desktop:package": "node scripts/desktop-package.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.4",
    "fastify": "5.12.7",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
